# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0"
synopsis:
  "Hardcaml ASIC project and Tiny Tapeout bundle library, with the flow CLI"
description: """
Project elaboration, registered resources, and TT/LibreLane bundle emission, installed together with the hardcaml-asic-flow command and its runtime data so a consumer pins one revision for both.

Host requirements beyond the OCaml dependencies: Python 3.9 or newer for the flow command, and a POSIX shell. Provisioning additionally needs Bash, Git and the usual Unix utilities; running and postchecking a design need Docker, LibreLane and Nix. None of those are fetched by installing this package, and the record operations -- version, help, collect, report, archive -- need none of them."""
maintainer: ["Bohdan Purtell <bohdanpurtell@gmail.com>"]
authors: ["Bohdan Purtell <bohdanpurtell@gmail.com>"]
homepage: "https://github.com/LeEmperor/hardcaml_asic"
bug-reports: "https://github.com/LeEmperor/hardcaml_asic/issues"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.17" & >= "3.17"}
  "core"
  "hardcaml"
  "yojson"
  "cryptokit"
  "ppx_jane"
  "ppx_hardcaml"
  "conf-python-3"
  "expect_test_helpers_core" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/LeEmperor/hardcaml_asic.git"
