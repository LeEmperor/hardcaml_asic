(library
 (name hardcaml_asic_test)
     (modules (:standard \ inspection_parser_tests named_observation_race stage_report_consumer coarse_execution_consumer archive_consumer archive_encoding_consumer finalization_consumer postcheck_consumer report_consumer collect_consumer coarse_run_consumer preflight_consumer stage_domain_consumer project_api_consumer stage_recipe_contract execution_identity_driver execution_plan_consumer backend_protocol_driver process_supervisor_consumer execution_transport_consumer runtime_contract_consumer result_store_consumer checkpoint_consumer checkpoint_publisher_consumer runner_consumer segment_service_consumer stage_preparation_consumer observation_consumer observation_writer_consumer))
 ; The trailing -source-tree-root wins over the one dune passes (%{workspace_root},
 ; .. from here). Works around a ppx_expect v0.18~preview bug: it drops the directory
 ; from the test file's path when registering a test, then rebuilds the path at exit
 ; from the bare filename plus -source-tree-root. Drop this if a later ppx_expect fixes
 ; the path handling. Same workaround as hardcaml_networking's test suites.
 (inline_tests
  (flags
   (:standard -source-tree-root .)))
 (libraries core expect_test_helpers_core hardcaml hardcaml_asic)
 (preprocess
  (pps ppx_hardcaml ppx_jane)))

(rule
 (alias runtest)
  (deps check_bundle.py tt_bundle_tb.v ../dune-project ../toolchain.lock (source_tree ../flow) (source_tree ../lib) (source_tree ../examples))
 (action
  (run python3 %{dep:check_bundle.py} %{exe:../examples/tt_bundle_example.exe} %{workspace_root})))

; Source suites import flow/hardcaml_asic_flow, including retired SOURCE oracles.
; flow/dune installs only runtime-nine and four data files. One source_tree dep
; covers both subjects. ../toolchain.lock is named: data/toolchain.lock is a symlink to
; it, and a source_tree dependency does not pull in the file a symlink points at.
;
; test/test_installed_prefix.py is deliberately absent from this alias. It runs
; a nested `dune build -j20 @install`, which a runtest rule must not do.
; Run it explicitly: python3 -B test/test_installed_prefix.py
; Standalone --installed checks hardlink one disposable thin prefix at a time.
; reference_harness separates SOURCE-only retired oracles from runtime-nine
; installed bytes/helpers; explicit roots are mandatory under checkout denial.
; python3 -B test/check_installed_corpus.py reuses one thin hardlinked prefix,
; serializes independent installed-library builds and checks fixture restoration.
;
; check_resolved_flow_api.py also runs separately: it invokes Dune in an
; independent consumer. Run from the repository root:
; dune build @install && python3 test/check_resolved_flow_api.py
; Project API public consumer (also no nested Dune in runtest):
; dune build @install && python3 test/check_project_api.py

(rule
 (alias runtest)
 (deps test_phase4.py (source_tree ../flow) ../toolchain.lock)
 (action (run python3 %{dep:test_phase4.py})))

(rule
 (alias result-store)
 (deps test_result_store.py (source_tree ../flow) ../toolchain.lock)
 (action (run python3 -B %{dep:test_result_store.py})))

(alias
 (name runtest)
 (deps (alias result-store)))

(rule
 (alias runtest)
 (deps test_report.py (source_tree ../flow) ../toolchain.lock)
 (action (run python3 %{dep:test_report.py})))

