; test_flow_cli.py also drives scripts/flow.sh, the repository's example driver,
; to check that it routes every operation to this same dispatcher, so it depends
; on ../scripts as well. It replaces python3 with a recording stub for the
; routing cases and never runs dune, a provisioner or an external tool.

(rule
 (alias flow-cli)
 (deps
  test_flow_cli.py
  ../bin/flow_cli.exe
  ../bin/experimental_archive.exe
  ../bin/experimental_collect.exe
  ../bin/experimental_report.exe
  (source_tree ../flow)
  (source_tree ../scripts)
  ../toolchain.lock)
 (action (run python3 %{dep:test_flow_cli.py})))

(rule
