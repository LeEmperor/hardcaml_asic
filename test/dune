; P0 lifecycle, registration and selection tests.

(rule
 (alias observation-watch)
 (deps test_observation_watch.py test_stages.py (source_tree ../flow) ../toolchain.lock)
 (action (run python3 -B %{dep:test_observation_watch.py})))

(alias
 (name runtest)
 (deps (alias observation-watch)))

