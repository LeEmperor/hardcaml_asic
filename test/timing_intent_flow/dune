   ../../bin/experimental_timing_intent_inspect.exe
   ../../bin/experimental_archive.exe)
 (action (run python3 -B %{dep:check.py} %{exe:emitter.exe} %{exe:consumer.exe}
   %{exe:../../bin/flow_cli.exe} %{exe:../../bin/experimental_archive.exe}
    %{dep:../../flow/hardcaml_asic_flow/timing_intent_runtime.py})))

