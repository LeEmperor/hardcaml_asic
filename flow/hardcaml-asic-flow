#!/bin/sh
# Source-tree compatibility adapter. The installed entrypoint is a native binary.
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
if [ "$(basename "$(dirname "$here")")" = default ]; then
    binary="$here/../bin/flow_cli.exe"
else
    binary="$here/../_build/default/bin/flow_cli.exe"
fi
if [ ! -x "$binary" ]; then
    printf 'hardcaml-asic-flow: missing native CLI: %s. Run dune build -j20 @install.\n' "$binary" >&2
    exit 2
fi
exec "$binary" "$@"
